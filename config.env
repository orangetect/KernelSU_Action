# KernelSU Action -- build profile for Xiaomi MIX 4 (odin) + ReSukiSU
#
# Values here are defaults; workflow_dispatch inputs override them per run.
# Only the exact string "true" (or yes/on/1) counts as enabled.
#
# Copy this file to config/<device>.env to keep one profile per device, then
# pick it with the "Config file to build" input when you start a build.

CONFIG_ENV=config.env

# ============================================================ Kernel source ==

KERNEL_SOURCE=https://github.com/Inkypen79/kernel_xiaomi_odin
KERNEL_SOURCE_BRANCH=resukisu
KERNEL_CONFIG=odin_defconfig
KERNEL_IMAGE_NAME=Image
ARCH=arm64

# Optional: overrides the device label used in artifact names and sets
# CONFIG_LOCALVERSION. Leave blank to derive it from KERNEL_CONFIG.
KERNEL_NAME=odin-ReSukiSU
ADD_LOCALVERSION_TO_FILENAME=true

# Extra flags appended to every make invocation. Values may contain "=".
EXTRA_CMDS:LD=ld.lld KCFLAGS=-Wno-error
CUSTOM_CMDS:CLANG_TRIPLE=aarch64-linux-gnu-

# =================================================================== Clang ==
#
# 该 Action 已验证的 AOSP 下载对；r574158 仅是源码 defconfig 的构建标记，
# 并非 main-kernel-2025 分支上可下载的 Clang 归档。
CLANG_BRANCH=main-kernel-2025
CLANG_VERSION=r547379

USE_CUSTOM_CLANG=false
CUSTOM_CLANG_SOURCE=
CUSTOM_CLANG_BRANCH=

# 5.4 不建议全 LLVM
USE_LLVM=false

# ===================================================================== GCC ==
#
# 5.4 需要 GCC binutils
ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true
USE_CUSTOM_GCC_64=false
CUSTOM_GCC_64_SOURCE=
CUSTOM_GCC_64_BRANCH=
CUSTOM_GCC_64_BIN=aarch64-linux-android-
USE_CUSTOM_GCC_32=false
CUSTOM_GCC_32_SOURCE=
CUSTOM_GCC_32_BRANCH=
CUSTOM_GCC_32_BIN=arm-linux-androideabi-

# =============================================================== KernelSU ===

# Inkypen 的 resukisu 分支已在源码中集成 ReSukiSU 并启用 CONFIG_KSU。
# 使用 source 会验证该集成，但不会再执行 setup.sh 注入第二份 KernelSU。
KSU_VARIANT=source
KSU_REF=
KSU_HOOK_MODE=none

# Custom manager APK signature. Leave blank for the official manager.
KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=

# =================================================================== SUSFS ==
#
# 5.4 的 SUSFS 补丁比较旧，建议先 false 跑通，稳定后再开
ENABLE_SUSFS=false
SUSFS_REPO=https://gitlab.com/simonpunk/susfs4ksu.git
SUSFS_BRANCH=auto

# ========================================================== Extra patches ===

# 不对已集成 ReSukiSU 的内核树重打 path_umount/hook 补丁。
ENABLE_PATH_UMOUNT=false

# Extra fingerprint removal on top of SUSFS.
ENABLE_HIDE_STUFF=false

# SukiSU-Ultra 的 KPM，ReSukiSU 一般不需要
ENABLE_KPM=false

# ================================================================ Kconfig ===

ADD_KPROBES_CONFIG=false
ADD_OVERLAYFS_CONFIG=false
DISABLE_LTO=false
DISABLE_CC_WERROR=true

# Free-form defconfig lines, space or newline separated.
EXTRA_DEFCONFIG=

# ============================================================= AnyKernel3 ===

USE_CUSTOM_ANYKERNEL3=false
CUSTOM_ANYKERNEL3_SOURCE=
CUSTOM_ANYKERNEL3_BRANCH=
# Use the MIX 4 AK3 base supplied with this repository. Its updater binary,
# tools and anykernel.sh are copied from a package known to boot odin.
USE_BUNDLED_ODIN_AK3=true

# ============================================================== Packaging ===

NEED_DTBO=false

# 如果你想直接出 boot.img，把下面改成 true，并填一个能开机的原版 boot.img 直链
BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=

# ================================================================= Runner ===

ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
